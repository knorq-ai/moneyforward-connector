{
  "name": "@knorq/moneyforward-connector",
  "version": "0.2.0",
  "description": "MCP server for MoneyForward Cloud Invoice, Expense and Accounting APIs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "moneyforward-connector": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/tools.md",
    "README.ja.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node --test test/*.test.mjs",
    "pretest": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "presmoke": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm run smoke"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "moneyforward",
    "invoice",
    "expense",
    "accounting",
    "billing",
    "quote",
    "bookkeeping",
    "japan",
    "マネーフォワード"
  ],
  "author": "KNORQ Technologies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knorq-ai/moneyforward-connector.git"
  },
  "bugs": {
    "url": "https://github.com/knorq-ai/moneyforward-connector/issues"
  },
  "homepage": "https://github.com/knorq-ai/moneyforward-connector#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
